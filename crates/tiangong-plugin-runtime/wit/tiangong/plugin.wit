package tiangong:plugin;

/// 宿主时钟接口（host import）。
///
/// WASM 组件经此获取真实时间，替代宿主侧的 `chrono::Local::now()`。
interface clock {
    /// 返回自 UNIX epoch 起的毫秒数。
    now-millis: func() -> u64;
}

/// 记忆存储接口（host import）。
///
/// WASM 组件经此向 memory sidecar 发起请求。host 只暴露一个通用 request
/// 方法，复用 sidecar 的全部 memory 操作（召回/写入/反刍/CRUD），避免在
/// WIT 中逐个硬编码 memory 数据结构与操作。
///
/// `method` 对应 sidecar IPC 协议（MemoryIpcRequestPayload）的变体名；
/// `payload` 为入参的 JSON 文本；返回结果序列化为 JSON 文本。
interface memory-store {
    /// 存储错误。
    variant memory-store-error {
        message(string),
        disabled,
    }

    /// 通用请求：转发到 memory sidecar。
    request: func(
        method: string,
        payload: string,
    ) -> result<string, memory-store-error>;
}

/// 单文件 WASM 插件接口。
///
/// 所有方法只传递有版本的结构化数据；JSON Schema / 模型参数等复杂对象
/// 统一以 JSON 文本（string）承载。
interface plugin {
    /// 插件描述符，安装与日志展示用。
    record plugin-descriptor {
        id: string,
        name: string,
        version: string,
    }

    /// 工具规格，对应宿主侧 `ToolSpec`。
    /// `input-schema` 为 JSON Schema 文本。
    record tool-spec {
        name: string,
        description: string,
        input-schema: string,
    }

    /// 一次工具调用请求，对应宿主侧 `ToolCall`。
    /// `arguments` 为模型生成的参数 JSON 文本。
    record tool-call {
        id: string,
        name: string,
        arguments: string,
    }

    /// 工具执行结果，对应宿主侧 `ToolResult`。
    record tool-result {
        ok: bool,
        summary: string,
        stdout: string,
        stderr: string,
        exit-code: s32,
    }

    /// 插件错误统一以可读文本返回。
    variant plugin-error {
        message(string),
    }

    /// 返回插件描述符。零权限探测阶段调用。
    describe: func() -> result<plugin-descriptor, plugin-error>;

    /// 返回插件声明的全部工具规格。
    tool-specs: func() -> result<list<tool-spec>, plugin-error>;

    /// 返回插件贡献的 prompt 段落（注入 system prompt）。
    prompt-sections: func() -> result<list<string>, plugin-error>;

    /// 处理一次工具调用，返回执行结果。
    handle-tool: func(call: tool-call) -> result<tool-result, plugin-error>;

    /// 关闭插件，释放资源。
    shutdown: func() -> result<_, plugin-error>;

    /// 注入当前会话工作目录（对应宿主 `Plugin::set_workspace`）。
    /// `workspace` 为目录路径文本，None 表示无有效工作目录。
    set-workspace: func(workspace: option<string>) -> result<_, plugin-error>;

    /// CoreConfig 变更通知（对应宿主 `Plugin::on_config_updated`）。
    /// `config-json` 为 CoreConfig 的 JSON 文本。
    on-config-updated: func(config-json: string) -> result<_, plugin-error>;

    // ── 生命周期钩子 ──
    // session-json 为宿主 Session 的 JSON 文本（可序列化部分）。
    // 各钩子经 memory-store.request 转发到 sidecar 的对应能力。

    /// 会话就绪（对应 `Plugin::on_session_ready`）。
    on-session-ready: func(session-json: string) -> result<_, plugin-error>;

    /// 轮次开始（对应 `Plugin::on_turn_started`）。
    /// turn-start-idx 为本轮用户消息在 session.messages 中的起始索引。
    on-turn-started: func(
        session-json: string,
        turn-start-idx: u32,
    ) -> result<_, plugin-error>;

    /// 轮次结束（对应 `Plugin::on_turn_finished`，触发 micro 反刍）。
    on-turn-finished: func(
        session-json: string,
        turn-start-idx: u32,
    ) -> result<_, plugin-error>;

    /// 会话结束（对应 `Plugin::on_session_ended`，触发 meso 反刍）。
    on-session-ended: func(session-json: string) -> result<_, plugin-error>;
}

/// WASM 插件 world：导入宿主时钟与记忆存储，导出 `plugin` 接口。
world tiangong-plugin {
    import clock;
    import memory-store;
    export plugin;
}
