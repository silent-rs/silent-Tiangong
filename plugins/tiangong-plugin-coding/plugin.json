{
  "schema_version": 2,
  "id": "coding",
  "name": "Coding",
  "version": "0.2.1",
  "wasm": {
    "binary": "tiangong_plugin_coding_wasm.wasm"
  },
  "sidecar": {
    "binary": "tiangong-coding-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 2,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 30000,
    "lifecycle": "on_demand"
  },
  "permissions": [
    "sidecar.invoke",
    "bridge.call"
  ],
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "session.input-status",
        "id": "branch-switcher",
        "title": "分支切换",
        "entry": "app/index.html",
        "context": ["session"]
      }
    ]
  },
  "entrypoints": [
    "desktop",
    "cli",
    "server"
  ]
}
