{
  "schema_version": 1,
  "id": "generate-image-openai",
  "version": "0.1.0",
  "wasm": {
    "binary": "tiangong_plugin_generate_image_openai_wasm.wasm"
  },
  "sidecar": {
    "binary": "tiangong-generate-image-openai-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 120000
  },
  "permissions": [
    "model-config.read",
    "sidecar.invoke"
  ],
  "entrypoints": [
    "desktop",
    "cli",
    "server"
  ],
  "model_requirements": [
    {
      "kind": "chat",
      "required": false
    }
  ],
  "mention": {
    "hint": "根据文字描述生成图片（OpenAI）"
  }
}
