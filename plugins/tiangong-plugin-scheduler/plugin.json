{
  "schema_version": 1,
  "id": "scheduler",
  "version": "0.1.0",
  "wasm": {
    "binary": "tiangong_plugin_scheduler_wasm.wasm"
  },
  "sidecar": {
    "binary": "tiangong-scheduler-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 60000,
    "transport": "stdio",
    "sandbox": true,
    "sandbox_network": true
  },
  "permissions": [
    "app-storage.read",
    "sidecar.invoke"
  ]
}
