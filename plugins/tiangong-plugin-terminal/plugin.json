{
  "schema_version": 2,
  "id": "terminal",
  "version": "0.1.0",
  "entrypoints": [
    "desktop"
  ],
  "permissions": [
    "tool.provide",
    "sidecar.invoke",
    "bridge.call",
    "bridge.events",
    "app.use"
  ],
  "tools": [
    {
      "name": "run_command",
      "description": "执行受控命令（通过 PTY，输出回显到终端面板）。支持 cwd 和超时设置。",
      "input_schema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "description": "命令名"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "命令参数列表"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录（可选）"
          },
          "timeout": {
            "type": "integer",
            "description": "可选的最长运行秒数；仅在任务有明确时间边界时设置，不填则持续到命令完成或被中断",
            "minimum": 1
          }
        },
        "required": [
          "cmd"
        ]
      },
      "timeout_ms": 300000
    },
    {
      "name": "run_shell",
      "description": "在终端执行 shell 脚本（通过 PTY，支持交互式程序）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "要执行的 shell 脚本"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录（可选）"
          },
          "timeout": {
            "type": "integer",
            "description": "可选的最长运行秒数；不填则持续到脚本完成或被中断",
            "minimum": 1
          },
          "interactive": {
            "type": "boolean",
            "description": "是否启动交互程序，默认 false"
          }
        },
        "required": [
          "script"
        ]
      },
      "timeout_ms": 300000
    },
    {
      "name": "terminal_send",
      "description": "向终端发送按键/文本输入。默认发送到最近执行的终端；结果会告知实际送达的终端编号。",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "要发送的按键/文本"
          },
          "terminal_id": {
            "type": "string",
            "description": "可选：定向发送的终端编号（run_command / terminal_send 结果中告知的编号）"
          },
          "wait": {
            "type": "integer",
            "description": "发送后等待秒数，默认 3",
            "minimum": 1
          }
        },
        "required": [
          "input"
        ]
      },
      "timeout_ms": 120000
    },
    {
      "name": "terminal_open",
      "description": "打开终端面板（向用户展示命令执行、跟踪长任务时使用）。面板编号由插件管理并在结果中告知。",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "timeout_ms": 30000
    },
    {
      "name": "terminal_close",
      "description": "关闭终端面板（后台命令继续运行）。默认关闭 Agent 最近打开的面板；多面板时可传面板编号精确关闭。",
      "input_schema": {
        "type": "object",
        "properties": {
          "tab_id": {
            "type": "string",
            "description": "可选：要关闭的面板编号（terminal_open 结果中告知的编号）"
          }
        }
      },
      "timeout_ms": 30000
    }
  ],
  "prompt": [
    "终端工具使用规范：执行命令用 run_command（带参数列表），执行 shell 脚本用 run_shell，结果会告知实际执行的终端编号；向运行中的终端输入内容用 terminal_send（缺省发到最近执行的终端，可用 terminal_id 定向）；向用户展示终端或跟踪长任务时用 terminal_open 打开面板，用户要求收起时用 terminal_close（默认关闭 Agent 最近打开的面板，后台命令不受影响）。长命令设置 timeout（秒）；只在有明确时间边界时设置。"
  ],
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "extension.tab",
        "id": "terminal",
        "title": "终端",
        "description": "嵌入式终端，支持多标签与会话隔离",
        "icon": "terminal",
        "entry": "dist/index.html",
        "open_mode": "multi",
        "context": [
          "session"
        ]
      }
    ]
  },
  "capabilities": {
    "tools": true,
    "prompt": true,
    "events": ["tool.*", "sidecar.*"]
  },
  "sidecar": {
    "binary": "tiangong-terminal-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 300000
  }
}
