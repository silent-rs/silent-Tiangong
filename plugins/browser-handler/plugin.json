{
  "schema_version": 2,
  "id": "browser-handler",
  "version": "0.1.0",
  "entrypoints": [
    "desktop"
  ],
  "permissions": [
    "tool.provide",
    "webview.use",
    "bridge.call"
  ],
  "capabilities": {
    "tools": true,
    "prompt": true
  },
  "tools": [
    {
      "name": "browser_open",
      "description": "打开浏览器面板并导航到指定 URL（与用户共用同一页面）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "目标 URL"
          }
        },
        "required": [
          "url"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "browser_navigate",
      "description": "在当前浏览器会话中导航到新页面。",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "目标 URL"
          }
        },
        "required": [
          "url"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "browser_eval",
      "description": "在当前页面执行 JavaScript 并返回结果。",
      "input_schema": {
        "type": "object",
        "properties": {
          "js": {
            "type": "string",
            "description": "要执行的 JavaScript 表达式"
          }
        },
        "required": [
          "js"
        ]
      },
      "timeout_ms": 60000
    }
  ],
  "prompt": [
    "浏览器工具使用规范：需要查看网页或让用户看到页面时用 browser_open；在已打开的页面上继续导航用 browser_navigate；提取页面信息用 browser_eval。"
  ],
  "ui": {
    "sandbox": "webview",
    "contributions": [
      {
        "slot": "extension.tab",
        "id": "browser",
        "title": "浏览器",
        "description": "嵌入式浏览器（webview 容器原语 + 插件管理界面）",
        "icon": "globe",
        "entry": "dist/index.html",
        "open_mode": "singleton",
        "context": [
          "session"
        ]
      }
    ]
  }
}
