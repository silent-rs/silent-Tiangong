{
  "schema_version": 2,
  "id": "interaction-handler",
  "version": "0.1.0",
  "entrypoints": [
    "desktop"
  ],
  "permissions": [
    "interaction.handle"
  ],
  "capabilities": {
    "interaction": true,
    "events": [
      "interaction.*"
    ]
  },
  "ui": {
    "sandbox": "iframe",
    "contributions": [
      {
        "slot": "session.interaction",
        "id": "interaction-handler",
        "title": "交互处理器",
        "description": "默认交互处理器：审批、确认、选择、输入与表单",
        "entry": "dist/index.html",
        "context": [
          "session"
        ]
      }
    ]
  }
}
