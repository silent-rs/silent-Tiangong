{
  "schema_version": 2,
  "id": "subagent",
  "version": "0.1.0",
  "entrypoints": [
    "desktop"
  ],
  "permissions": [
    "tool.provide",
    "sidecar.invoke",
    "bridge.call",
    "bridge.events",
    "app.use"
  ],
  "tools": [
    {
      "name": "list_agents",
      "description": "查看全部持久 Subagent 的列表、后端类型、当前会话激活状态与运行实例状态。",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "timeout_ms": 30000
    },
    {
      "name": "get_agent",
      "description": "查看某个 Subagent 的详情：身份配置、长期指令、最近任务与事件、产物数量。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Agent ID（list_agents 结果中给出）"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "activate_agent",
      "description": "在当前会话激活某个 Subagent，绑定当前会话 Workspace（只读/独占写/隔离 worktree 策略生效）。激活后才能发送消息与提交任务。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "要激活的 Agent ID"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "timeout_ms": 60000
    },
    {
      "name": "deactivate_agent",
      "description": "在当前会话停用某个 Subagent：中断其在本会话上的运行实例并释放 Workspace 写入所有权。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "要停用的 Agent ID"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "timeout_ms": 60000
    },
    {
      "name": "list_active_agents",
      "description": "查看当前会话已激活的 Subagent 及其运行实例状态。",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "timeout_ms": 30000
    },
    {
      "name": "send_agent_message",
      "description": "向指定 Subagent 发送普通消息：用于追问、补充背景、纠正方向和一般交流。有运行实例时注入当前运行，否则启动一次轻量消息往返；回复经反馈通道返回本会话。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "目标 Agent ID（须已在当前会话激活）"
          },
          "content": {
            "type": "string",
            "description": "消息内容"
          }
        },
        "required": [
          "agent_id",
          "content"
        ]
      },
      "timeout_ms": 60000
    },
    {
      "name": "submit_agent_task",
      "description": "向指定 Subagent 提交有明确完成条件的正式任务。立即返回任务与运行编号，执行在后台进行；完成、阻塞、审批或失败会反馈到本会话。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "目标 Agent ID（须已在当前会话激活）"
          },
          "goal": {
            "type": "string",
            "description": "任务目标（要做什么）"
          },
          "completion_criteria": {
            "type": "string",
            "description": "完成条件（怎样算做完）"
          }
        },
        "required": [
          "agent_id",
          "goal"
        ]
      },
      "timeout_ms": 60000
    },
    {
      "name": "get_agent_task",
      "description": "查看某个任务的详情与全部运行记录。",
      "input_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "任务 ID（submit_agent_task 结果中给出）"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "list_agent_tasks",
      "description": "查看任务列表（默认当前会话，指定 agent_id 时列出该 Agent 全部任务）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "可选，按 Agent 过滤"
          }
        }
      },
      "timeout_ms": 30000
    },
    {
      "name": "get_agent_run",
      "description": "查看某次运行的详情与事件流（输出摘要、终态、时间线）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "运行 ID"
          }
        },
        "required": [
          "run_id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "interrupt_agent_run",
      "description": "中断某个运行（保留现场，运行可继续输出或被再次控制）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "要中断的运行 ID"
          }
        },
        "required": [
          "run_id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "cancel_agent_run",
      "description": "取消某个运行（终态，托管进程会被终止）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "要取消的运行 ID"
          }
        },
        "required": [
          "run_id"
        ]
      },
      "timeout_ms": 60000
    },
    {
      "name": "list_agent_events",
      "description": "查看事件历史（运行状态、输出、阻塞、审批、完成、失败），可按 Agent 或运行过滤。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "可选，按 Agent 过滤"
          },
          "run_id": {
            "type": "string",
            "description": "可选，按运行过滤"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限，默认 20",
            "minimum": 1
          }
        }
      },
      "timeout_ms": 30000
    },
    {
      "name": "get_agent_artifacts",
      "description": "查看某个 Subagent 的历史产物列表（身份目录 artifacts/ 下）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Agent ID"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "timeout_ms": 30000
    }
  ],
  "prompt": [
    "Subagent 工具使用规范：list_agents 查看可用的持久 Subagent；向某个 Subagent 交办工作前必须先用 activate_agent 在当前会话激活（自动绑定当前 Workspace）。追问、补充背景、纠正方向用 send_agent_message；有明确目标和完成条件的正式工作用 submit_agent_task（立即返回，完成、阻塞、审批或失败会自动反馈到本会话，无需轮询等待）。跟踪进度用 list_agent_events / get_agent_run / get_agent_task；需要停止时用 interrupt_agent_run（可恢复现场）或 cancel_agent_run（终态）。同一 Workspace 同时只有一个写入者，激活被拒时说明工作区被占用。"
  ],
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "extension.tab",
        "id": "subagent",
        "title": "Subagent",
        "description": "持久 Subagent 管理台：身份、激活、任务与运行状态",
        "icon": "bot",
        "entry": "dist/index.html",
        "open_mode": "multi",
        "context": [
          "session",
          "workspace"
        ]
      }
    ]
  },
  "capabilities": {
    "tools": true,
    "prompt": true,
    "events": [
      "tool.*",
      "sidecar.*"
    ]
  },
  "sidecar": {
    "binary": "tiangong-subagent-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 120000,
    "lifecycle": "resident"
  }
}
